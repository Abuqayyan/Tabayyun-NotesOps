# ============================================================================
# OpsCore — environment template. Copy to `.env` and fill in. NEVER commit .env.
#   cp .env.example .env
# ============================================================================

# ---- REQUIRED secrets (the app fails fast on startup if these are missing) ----

# Strong random string, >= 32 chars. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Valid Fernet key (44-char urlsafe base64). Generate ONCE and keep it stable —
# rotating it makes all previously-encrypted SMTP passwords / AI keys unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- MongoDB (internal only; not published to host) ----
MONGO_USERNAME=opscore
MONGO_PASSWORD=            # REQUIRED — choose a strong password
DB_NAME=opscore

# ---- PostgreSQL (internal only; Phase 0 infrastructure) ----
POSTGRES_USER=opscore
POSTGRES_PASSWORD=         # REQUIRED — choose a strong password
POSTGRES_DB=opscore

# ---- CORS: explicit allowed origins (comma-separated). No wildcard with credentials ----
# Set to your real frontend origin in production (e.g. https://app.yourcompany.com).
CORS_ORIGINS=http://localhost:3000

# ---- Frontend build-time backend URL (baked into the React bundle) ----
REACT_APP_BACKEND_URL=http://localhost:8001

# ---- Optional ----
PUBLIC_APP_URL=                       # absolute app URL used in emails (e.g. https://app.yourcompany.com)
EMERGENT_LLM_KEY=                     # fallback Anthropic key when a user hasn't added their own
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
JWT_EXPIRE_DAYS=30
